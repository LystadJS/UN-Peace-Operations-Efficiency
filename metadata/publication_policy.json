{
  "schema_version": 1,
  "base_branch": "main",
  "publication_mode": "candidate_branch_and_pull_request",
  "branch_prefix": "release-candidates/",
  "maximum_zip_bytes": 33554432,
  "maximum_uncompressed_bytes": 67108864,
  "maximum_file_bytes": 16777216,
  "allowed_current_paths": [
    "README.md",
    "docs/current_status.md",
    "metadata/current_status.json",
    "metadata/project_health.json",
    "docs/project_health.md"
  ],
  "allowed_additive_release_prefix": "reports/releases/",
  "additive_release_extensions": [
    ".md",
    ".json",
    ".csv",
    ".pdf",
    ".docx",
    ".png",
    ".svg"
  ],
  "historical_candidate_workflows": [
    ".github/workflows/additional_mission_training_frame.yml",
    ".github/workflows/census_v5.yml",
    ".github/workflows/census_v5_release.yml",
    ".github/workflows/census_v6_release.yml",
    ".github/workflows/census_v7_recovery.yml",
    ".github/workflows/census_v7_release.yml",
    ".github/workflows/deeper_official_archives_v4.yml",
    ".github/workflows/mission_archive_census.yml",
