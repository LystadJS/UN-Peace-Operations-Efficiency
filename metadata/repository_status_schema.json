{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unpo:repository-status:1",
  "title": "Repository status snapshots: orthogonal facets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs", "rationale"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "currency": {"allOf": [{"$ref": "#/$defs/facet"}, {"properties": {"status": {"enum": ["CURRENT", "HISTORICAL", "SUPERSEDED", "CANDIDATE", "UNRESOLVED"]}}}]},
    "research_adoption": {"allOf": [{"$ref": "#/$defs/facet"}, {"properties": {"status": {"enum": ["ADOPTED_FOR_RESEARCH", "NOT_ADOPTED", "NOT_APPLICABLE", "UNKNOWN"]}}}]},
    "institutional_approval": {"allOf": [{"$ref": "#/$defs/facet"}, {"properties": {"status": {"enum": ["APPROVED", "NOT_APPROVED", "NOT_APPLICABLE", "UNKNOWN"]}}}]},
    "implementation": {"allOf": [{"$ref": "#/$defs/facet"}, {"properties": {"status": {"enum": ["IMPLEMENTED", "PARTIALLY_IMPLEMENTED", "REPORTED_NOT_VERIFIED", "NOT_IMPLEMENTED", "NOT_APPLICABLE", "UNKNOWN"]}}}]},
    "live_use": {"allOf": [{"$ref": "#/$defs/facet"}, {"properties": {"status": {"enum": ["BLOCKED", "PAUSED", "AUTHORIZED", "NOT_APPLICABLE", "UNKNOWN"]}}}]},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "version", "scope", "role", "as_of", "evidence_cutoff", "superseded_by", "currency", "research_adoption", "institutional_approval", "implementation", "live_use"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date"},
        "evidence_cutoff": {"type": "string", "format": "date"},
        "superseded_by": {"type": ["string", "null"]},
        "currency": {"$ref": "#/$defs/currency"},
        "research_adoption": {"$ref": "#/$defs/research_adoption"},
        "institutional_approval": {"$ref": "#/$defs/institutional_approval"},
        "implementation": {"$ref": "#/$defs/implementation"},
        "live_use": {"$ref": "#/$defs/live_use"}
      }
    }
  },
  "x-semantic-rules": [
    "Every definitive facet status requires a nonempty evidence reference list; UNKNOWN, UNRESOLVED and NOT_APPLICABLE require rationale but may have no references.",
    "CURRENT is unique per scope and role; status applies only within that scope.",
    "SUPERSEDED requires an existing replacement with the same scope and role; supersession must be acyclic.",
    "AUTHORIZED live use requires APPROVED institutional approval; neither research adoption nor implementation implies that approval.",
    "Dates must parse; evidence_cutoff may not follow as_of. Paths are relative repository paths without traversal."
  ]
}
